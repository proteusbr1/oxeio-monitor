# Safety net at the repo root.
# Detailed rules live in oxeio-monitor/.gitignore; the `**/` here matches at every
# level, so adding agent/ or web/ later leaves no gap.

# ── Never committed ───────────────────────────────
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# ── Generated files ───────────────────────────────
**/node_modules/
**/dist/
**/build/
**/coverage/
**/.data/
**/.tmp-test-storage/
*.log

# TypeScript incremental build cache
*.tsbuildinfo

# .NET (agent, Phase 2)
**/bin/
**/obj/

# ── OS and editor ─────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Careful: the real staff list - names and salaries. Never committed.
#    The seed falls back to staff.example.json when this file is missing.
**/staff.local.json
# a deployment's own holiday calendar, imported with prisma/import-holidays.ts
**/holidays.local.*

# Careful: any backup/copy of .env too. A file like this (.env.bak-before-trial)
# was once committed by mistake, because the `**/.env` pattern above does not
# match `.env.bak-*`.
**/.env.bak*
**/.env.backup*
**/.env.old*
**/.env.save*
**/*.env.bak*

# Temporary Syncthing files - committed by mistake twice
~syncthing~*

# Claude Code's machine-specific permission list.
#
# Careful: `settings.json` (shared) is committed, `settings.local.json` is not.
#    The latter remembers "allow these commands on this machine", so it is of
#    no use to anyone else. The repo is public, so there is no reason to
#    publish local paths and hostnames.
.claude/settings.local.json
