// ─────────────────────────────────────────────────────────────────────────────
//  oXeio Monitoring — database schema  ·  19 models
//
//  Source of truth : docs/history/07-Technical-Spec.md § 2
//  Calculation rules: docs/history/07-Technical-Spec.md § 2.1 (a-e)
//
//  Four decisions this schema enforces at the type level:
//    · SegmentState has only three values; BREAK/MEETING/OFF_SHIFT do not exist (ADR-011d)
//    · there are no shifts / leave_requests / time_claims tables (ADR-011b, 011d)
//    · every ingest table has clientUuid, to stop duplicates (G29)
//    · workedSec (raw) and creditedSec (counts toward the target) are kept apart (G35)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════ enums ══════════════════════════════

/// Only three states. BREAK / MEETING / OFF_SHIFT are deliberately absent (ADR-011d).
enum SegmentState {
  active
  idle
  locked
}

/// **Portal role**: who can enter which screen.
///
/// Careful: do not confuse it with `Employee.receivesTasks`: that is **what work they
/// get handed**; this is **what they are allowed to see**.
///
/// `coordinator` adds tasks to the pool and checks finished ones, and otherwise sees
/// only their own data, like `employee`. Permission lives on the role, in one table,
/// so the sidebar needs no per-person exception.
///
/// Careful: adding a new value is NOT fail-closed everywhere. `@Roles()` and the
/// sidebar's `roles[]` run on allowlists, so they are safe. But a hand-written
/// `role !== employee` condition **opens the wrong way**; those are now written as
/// `owner || manager`.
enum UserRole {
  owner
  manager
  coordinator
  employee
}

/**
 * Which stage of its life a task is in.
 *
 * Careful: `skipped` is kept apart from `done`: a skipped task is nobody's
 * work, so it is not counted, but it also does not go back to the pool, otherwise it
 * would land in someone's hands again the next day.
 */
enum TaskStatus {
  pool
  assigned
  done
  skipped

  /**
   * **Removed from the work** by the owner, a manager or a coordinator.
   *
   * Careful: the row **stays in the table**, and that is the whole reason for this
   * value: `reference` is UNIQUE, so a removed task can never come back into the pool
   * by being pasted again. A real `DELETE` would remove exactly that guard.
   *
   * Careful: not `skipped`: that is the assignee's "I am not doing this one"; this is
   * "the task itself is gone".
   */
  deleted
}

enum EmployeeStatus {
  active
  inactive
}

enum DeviceStatus {
  active
  revoked
}

enum Productivity {
  productive
  neutral
  unproductive
}

enum MatchType {
  process
  domain
  title_regex
}

enum DayType {
  worked
  no_activity
  holiday
}

/// day_rollover = the session was split at midnight (§ 2.1-a). There is no shift_end: there are no shifts.
enum SessionEndReason {
  logoff
  shutdown
  timeout
  day_rollover
}

enum AdjustmentCause {
  agent_down
  server_down
  agent_crash
  pc_replaced
  data_loss
  other
}

enum AlertSeverity {
  info
  warning
  critical
}

enum RolloutStage {
  canary
  partial
  all
  halted
}

// ══════════════════════════ reference / config ══════════════════════════

/// Careful: this replaces a shifts table. There is no shift window, lunch window or fixed arrival time.
/// How a work policy states the hours it expects (see src/calendar/work-regime.ts).
/// Every basis becomes "hours per workday"; the month's target is that times
/// the workdays in it (minus leave).
enum TargetBasis {
  /// monthlyTargetHours ÷ expectedWorkdays per workday (the original model)
  month
  /// weeklyTargetHours ÷ working days in the week
  week
  /// dailyTargetHours per workday — e.g. a fixed 09:00–18:00 schedule with a 1 h break
  day
  /// no target: hours are recorded and shown, nobody is ahead or behind
  none
}

/// How a person is paid (payroll)
enum PayBasis {
  /// a monthly salary, prorated to the days employed; missing hours deducted if the policy says so
  monthly
  /// an hourly rate × hours counted (paid leave included)
  hourly
  /// not paid through oXeio — hours only
  none
}

/// How a work policy counts hours (src/summary/summary.math.ts)
enum HoursMeasure {
  /// keyboard/mouse time only (the original measure)
  active
  /// first to last use of the computer, minus pauses longer than presence_gap_min
  presence
}

model WorkPolicy {
  id                 Int     @id @default(autoincrement())
  name               String
  /// The only target
  targetBasis        TargetBasis @default(month) @map("target_basis")
  monthlyTargetHours Decimal @default(176) @map("monthly_target_hours") @db.Decimal(6, 2)
  /// basis = week: hours per week (e.g. 40)
  weeklyTargetHours  Decimal? @map("weekly_target_hours") @db.Decimal(5, 2)
  /// basis = day: hours per workday (e.g. 8)
  dailyTargetHours   Decimal? @map("daily_target_hours") @db.Decimal(4, 2)
  /// break taken out of a fixed schedule (basis = day with office hours set); informational
  breakMinutes       Int?     @map("break_minutes")
  /// overtime (hours above the month's target) is paid at this multiple of the hourly rate; null = not paid
  overtimeMultiplier Decimal? @map("overtime_multiplier") @db.Decimal(4, 2)
  /// monthly salaries: missing hours are deducted from pay (the original rule)
  deductShortfall    Boolean  @default(true) @map("deduct_shortfall")
  /// what counts as worked time: active input, or presence (see HoursMeasure)
  hoursMeasure       HoursMeasure @default(active) @map("hours_measure")
  /// presence: the longest pause, in minutes, that still counts as work
  presenceGapMin     Int      @default(15) @map("presence_gap_min")
  /// Fallback only: the real count comes from the calendar, § 2.1-b
  expectedWorkdays   Int     @default(22) @map("expected_workdays")
  /// Careful: this is not a block: hours worked on a day off are still counted in full.
  /// ISO days off (Mon = 1 … Sun = 7), several allowed: [6, 7] for Sat+Sun,
  /// [5] for a Friday-only weekend. Empty = every calendar day is a workday
  /// (was `weekly_off_day` null).
  weeklyOffDays      Int[]   @default([]) @map("weekly_off_days") @db.SmallInt
  /// 'HH:MM': the capture window. When null, pictures are taken 24 hours a day.
  screenshotFrom     String? @map("screenshot_from") @db.VarChar(5)
  screenshotTo       String? @map("screenshot_to") @db.VarChar(5)
  /// false = no screenshots at all for this policy. ⚠️ The agent still samples
  /// the screen locally for the jiggler check (G46), so hours are unchanged.
  screenshotsEnabled Boolean @default(true) @map("screenshots_enabled")
  /**
   * **When the office is open** *(22 August 2026)*: the owner wants 9:00-18:00.
   *
   * Careful: this is NOT a substitute for `screenshotFrom/To`, it is a different
   * question. The capture window is 7:00-11:00 (so that pictures are taken even if
   * someone comes early or stays late), but the **office** is 9:00-18:00. Treating the
   * two as one would count a PC being off at 19:00 as a "problem".
   *
   * So far its only use: when NOT to raise an `agent_down` alert (G01). When the office
   * is closed, a PC being off is normal, not news.
   * Careful: it has no effect on counting hours: if someone works at 21:00, their hours
   * are still counted in full, as before.
   *
   * When null, the office is assumed **open all day**: the earlier behaviour, so that
   * alerts do not go silent when no value is set.
   */
  officeFrom         String? @map("office_from") @db.VarChar(5)
  officeTo           String? @map("office_to") @db.VarChar(5)
  /**
   * **Tasks per day** for people who receive tasks (Tasks module).
   *
   * Careful: it sits **beside** the hours target, not instead of it. It applies only to
   * staff with `receives_tasks` (`hasTaskTarget()`); for the rest the cell does not
   * even show on screen, because "0/25" looks like an accusation when the measure is
   * not theirs at all.
   * Careful: setting 0 switches the target **off**: counting continues, but nobody is "behind".
   */
  dailyTaskTarget    Int     @default(25) @map("daily_task_target")
  idleThresholdSec   Int     @default(60) @map("idle_threshold_sec")
  slotMinutes        Int     @default(5) @map("slot_minutes")
  /// IANA zone the work day is cut in (the server's `WORK_TIMEZONE`); daylight saving is handled
  timezone           String  @default("UTC")
  isActive           Boolean @default(true) @map("is_active")

  employees Employee[]

  @@map("work_policies")
}

model Employee {
  id             Int            @id @default(autoincrement())
  empCode        String         @unique @map("emp_code")
  fullName       String         @map("full_name")
  email          String?        @unique
  /// Job title: free text, for display only ("Senior Accountant")
  designation    String?
  department     String?
  /**
   * **Gets tasks handed out** (Tasks module): the morning hand-out and the top-ups
   * go only to people with this on.
   *
   * Careful: receiving tasks and having a daily target are two questions. "Has a
   * target" = this AND an effective `dailyTaskTarget` above 0 (`hasTaskTarget()`).
   */
  receivesTasks  Boolean        @default(false) @map("receives_tasks")
  /**
   * **This employee's own daily task target**: some people do 25 a day, some 15.
   *
   * Careful: `null` means **the policy's number applies** (`work_policies.daily_task_target`),
   * not zero; 0 switches this person's target off. Careful: there is deliberately no
   * default: with a default, "nobody said anything" and "the owner chose this number
   * himself" would look the same, exactly as with `depositStartYearMonth`.
   */
  dailyTaskTarget Int?          @map("daily_task_target")
  policyId       Int?           @map("policy_id")
  /// Monthly salary: **only the owner can see it** ([ADR-023](../../docs/history/05-Options-Decisions.md)).
  /// Needed to work out the money for a shortfall: (salary / monthly target hours) x shortfall hours.
  /// Careful: Decimal, not Float: money is never kept in a binary float.
  payBasis       PayBasis       @default(monthly) @map("pay_basis")
  monthlySalary  Decimal?       @map("monthly_salary") @db.Decimal(12, 2)
  /// payBasis = hourly: the rate per hour, in the configured currency
  hourlyRate     Decimal?       @map("hourly_rate") @db.Decimal(12, 2)
  /// Old salaries, so past payroll does not move (see the SalaryPeriod doc)
  salaryPeriods  SalaryPeriod[]
  joinedOn       DateTime?      @map("joined_on") @db.Date

  /**
   * R21: **from which month the deposit deduction starts**, for this employee (`YYYY-MM`).
   *
   * `null` means "the rule's general start month applies"
   * (`deposit_policy.start_year_month`), so all the old rows work as before.
   *
   * Careful: there is deliberately no default: with a default, "nobody said anything"
   * and "the owner chose this month himself" would look the same.
   */
  depositStartYearMonth String? @map("deposit_start_year_month") @db.Char(7)
  leftOn         DateTime?      @map("left_on") @db.Date
  status         EmployeeStatus @default(active)
  /// Signed monitoring policy: a mandatory condition of the rollout
  policySignedAt DateTime?      @map("policy_signed_at") @db.Timestamptz(3)
  policyDocPath  String?        @map("policy_doc_path")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  policy            WorkPolicy?        @relation(fields: [policyId], references: [id])
  devices           Device[]
  portalUsers       User[]
  workSessions      WorkSession[]
  segments          ActivitySegment[]
  screenshots       Screenshot[]
  appUsage          AppUsage[]
  events            Event[]
  dailySummaries    DailySummary[]
  taskCredits       TaskCredit[]
  tasks             Task[]
  monthlySummary    MonthlySummary[]
  timeAdjustments   TimeAdjustment[]
  enrollmentCodes   EnrollmentCode[]
  alerts            Alert[]
  leaves            Leave[]
  deposits          SecurityDeposit[]
  depositSettlement DepositSettlement?

  @@map("employees")
}

/// A user who logs into the dashboard: owner, manager, and staff self-view
model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  role         UserRole
  /// When role = employee, which staff member
  employeeId   Int?      @map("employee_id")
  totpSecret   String?   @map("totp_secret")
  isActive     Boolean   @default(true) @map("is_active")
  /// Must change the password at first login (G33)
  mustChangePw Boolean   @default(true) @map("must_change_pw")
  pwChangedAt  DateTime? @map("pw_changed_at") @db.Timestamptz(3)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  /// "Sign out other devices": a session issued before this second ends at its next refresh
  sessionsRevokedAt DateTime? @map("sessions_revoked_at") @db.Timestamptz(3)
  /// The person's own choices (theme; language later) — see account/preferences.ts
  preferences  Json      @default("{}")
  /// Tasks this user marked as "finished"
  completedTasks Task[] @relation("taskCompletedBy")
  /// Tasks this user checked: usually a coordinator
  checkedTasks   Task[] @relation("taskCheckedBy")
  /** Dropped tasks this user has looked over */
  reviewedTasks  Task[] @relation("taskReviewedBy")
  /// Fixed problems: usually a manager
  fixedTasks     Task[] @relation("taskFixedBy")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  employee           Employee?        @relation(fields: [employeeId], references: [id])
  auditLogs          AuditLog[]
  settingsUpdated    Setting[]
  alertsAcknowledged Alert[]
  enrollmentCodes    EnrollmentCode[]
  adjustmentsCreated TimeAdjustment[] @relation("AdjustmentCreatedBy")
  adjustmentsRevoked TimeAdjustment[] @relation("AdjustmentRevokedBy")

  @@map("users")
  /// Tasks this user added
  addedTasks Task[] @relation("addedTasks")
}

model Device {
  id              Int           @id @default(autoincrement())
  hostname        String
  windowsUsername String        @map("windows_username")
  employeeId      Int?          @map("employee_id")
  /// Permanent hardware-based id
  /// Careful: **no longer UNIQUE**: if two staff members work on the same PC under
  /// different Windows accounts, two rows are needed, yet `MachineGuid` belongs to the
  /// machine, not the user. A device's identity is now `@@unique([hostname,
  /// windowsUsername])` (below): the machine AND whoever sits at it, together.
  /// The value is kept: H04's rollout bucket is counted from it, and the agent
  /// compares it with its own `device.dat` to catch clones.
  machineGuid     String        @map("machine_guid")
  osVersion       String?       @map("os_version")
  agentVersion    String?       @map("agent_version")
  /// **Since when this device has been running that version** *(5 September 2026)*.
  ///
  /// Careful: this is the only evidence for H04's rollout advancing by itself
  /// (`canary -> partial -> all`). `released_at` could not be used: it says **when it
  /// was published**, and the question is **how long a real machine has been running it
  /// and survived**. Advancing six hours after publishing would defeat the whole point of
  /// the canary: the stage would advance even if nobody had installed it.
  ///
  /// Careful: `null` means "unknown": that device gives no evidence. Old rows stay
  /// empty, and fill in at the next update.
  agentVersionSince DateTime?   @map("agent_version_since") @db.Timestamptz(3)
  /// sha256 of the device token: the plaintext is never stored
  tokenHash       String        @map("token_hash")
  monitors        Int           @default(1)
  status          DeviceStatus  @default(active)
  lastSeenAt      DateTime?     @map("last_seen_at") @db.Timestamptz(3)
  /// What the agent said in its last heartbeat. Without this the Live Board would
  /// **guess** from the last activity_segments row, and since the agent sends segments
  /// in batches, the board's status would look a few minutes old.
  lastState       SegmentState? @map("last_state")
  lastStateAt     DateTime?     @map("last_state_at") @db.Timestamptz(3)
  lastDriftSec    Int           @default(0) @map("last_drift_sec")
  maxDriftSec     Int           @default(0) @map("max_drift_sec")
  /// The agent's own report on its parts — `{ browserDomain: 'degraded', ... }`,
  /// see `agent/capabilities.rules.ts`. null until an agent that sends it checks in.
  capabilities    Json?
  /// When `capabilities` last changed (not every heartbeat — it rarely does)
  capabilitiesAt  DateTime?     @map("capabilities_at") @db.Timestamptz(3)
  enrolledAt      DateTime      @default(now()) @map("enrolled_at") @db.Timestamptz(3)

  employee        Employee?         @relation(fields: [employeeId], references: [id])
  workSessions    WorkSession[]
  segments        ActivitySegment[]
  screenshots     Screenshot[]
  appUsage        AppUsage[]
  events          Event[]
  alerts          Alert[]
  enrollmentCodes EnrollmentCode[]
  /** Releases for which this very PC is the pilot *(1 September 2026)* */
  pilotForVersions AgentVersion[] @relation("agentVersionPilot")

  @@unique([hostname, windowsUsername])
  @@map("devices")
}

/// Single-use code for agent registration (G34)
model EnrollmentCode {
  id             Int       @id @default(autoincrement())
  /// The code is never stored in plaintext: it is shown only once
  codeHash       String    @unique @map("code_hash")
  employeeId     Int       @map("employee_id")
  createdById    Int       @map("created_by")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(3)
  usedByDeviceId Int?      @map("used_by_device_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  employee     Employee @relation(fields: [employeeId], references: [id])
  createdBy    User     @relation(fields: [createdById], references: [id])
  usedByDevice Device?  @relation(fields: [usedByDeviceId], references: [id])

  @@map("enrollment_codes")
}

// ══════════════════════════ core tracking ══════════════════════════

/// A session from login to logout on a PC. Split at midnight (§ 2.1-a).
model WorkSession {
  id         BigInt            @id @default(autoincrement())
  employeeId Int               @map("employee_id")
  deviceId   Int               @map("device_id")
  /// The work-zone date (`WORK_TIMEZONE`)
  workDate   DateTime          @map("work_date") @db.Date
  startedAt  DateTime          @map("started_at") @db.Timestamptz(3)
  endedAt    DateTime?         @map("ended_at") @db.Timestamptz(3)
  endReason  SessionEndReason? @map("end_reason")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee          @relation(fields: [employeeId], references: [id])
  device   Device            @relation(fields: [deviceId], references: [id])
  segments ActivitySegment[]

  @@index([employeeId, workDate])
  @@map("work_sessions")
}

/// The main time-tracking table.
/// Careful: no segment may span two workDates: it is split at midnight (§ 2.1-a).
/// Careful: this table is never edited or deleted: corrections go in TimeAdjustment (§ 2.1-e).
model ActivitySegment {
  id           BigInt       @id @default(autoincrement())
  sessionId    BigInt       @map("session_id")
  employeeId   Int          @map("employee_id")
  /// To catch overlap between the same staff member's two devices (§ 2.1-c)
  deviceId     Int          @map("device_id")
  /// An id given by the agent: stops duplicates on retry (§ 2.1-d)
  clientUuid   String       @unique @map("client_uuid") @db.Uuid
  /// The work-zone date of startedAt
  workDate     DateTime     @map("work_date") @db.Date
  state        SegmentState
  startedAt    DateTime     @map("started_at") @db.Timestamptz(3)
  endedAt      DateTime     @map("ended_at") @db.Timestamptz(3)
  /// From the monotonic clock: unaffected even if the PC's clock changes
  durationSec  Int          @map("duration_sec")
  /// 0-100, how active it was during this chunk. Not keylogging.
  inputScore   Int?         @map("input_score") @db.SmallInt
  /// = (state == active); set at ingest
  countsAsWork Boolean      @default(false) @map("counts_as_work")

  session  WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employee Employee    @relation(fields: [employeeId], references: [id])
  device   Device      @relation(fields: [deviceId], references: [id])

  @@index([employeeId, workDate, state])
  @@index([startedAt])
  @@map("activity_segments")
}

model Screenshot {
  id           BigInt    @id @default(autoincrement())
  employeeId   Int       @map("employee_id")
  deviceId     Int       @map("device_id")
  clientUuid   String    @unique @map("client_uuid") @db.Uuid
  workDate     DateTime  @map("work_date") @db.Date
  /// Start of the 5-minute slot
  slotStart    DateTime  @map("slot_start") @db.Timestamptz(3)
  /// The actual random time: when within the slot the picture was taken
  capturedAt   DateTime  @map("captured_at") @db.Timestamptz(3)
  monitorIndex Int       @default(0) @map("monitor_index") @db.SmallInt
  filePath     String    @map("file_path")
  thumbPath    String?   @map("thumb_path")
  width        Int?
  height       Int?
  sizeBytes    Int?      @map("size_bytes")
  activeApp    String?   @map("active_app")
  activeTitle  String?   @map("active_title")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  /// The retention job marks it here, then deletes the file
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])
  device   Device   @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, slotStart, monitorIndex])
  @@index([employeeId, workDate])
  @@map("screenshots")
}

model AppUsage {
  id          BigInt   @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  deviceId    Int      @map("device_id")
  clientUuid  String   @unique @map("client_uuid") @db.Uuid
  workDate    DateTime @map("work_date") @db.Date
  startedAt   DateTime @map("started_at") @db.Timestamptz(3)
  endedAt     DateTime @map("ended_at") @db.Timestamptz(3)
  durationSec Int      @map("duration_sec")
  processName String   @map("process_name")
  appName     String?  @map("app_name")
  windowTitle String?  @map("window_title")
  /// Careful: domain only, never the full URL (ADR-013)
  domain      String?
  categoryId  Int?     @map("category_id")
  isBrowser   Boolean  @default(false) @map("is_browser")
  /// R22a: the state in which the chunk was observed.
  /// Careful: the default is `active`: old agents do not send the column, and
  /// everything they sent is by definition ACTIVE, so old rows keep their meaning.
  /// Careful: `idle` rows **go into no calculation**; every place that reads this
  /// has a `segmentState: 'active'` filter.
  segmentState SegmentState @default(active) @map("segment_state")

  employee Employee     @relation(fields: [employeeId], references: [id])
  device   Device       @relation(fields: [deviceId], references: [id])
  category AppCategory? @relation(fields: [categoryId], references: [id])

  @@index([employeeId, workDate])
  /// For R22b's overlap query: to match times against idle segments, the lookup
  /// has to go by `started_at`, not `work_date`
  @@index([employeeId, startedAt])
  @@index([domain])
  @@map("app_usage")
}

model AppCategory {
  id          Int          @id @default(autoincrement())
  matchType   MatchType    @map("match_type")
  /// 'code.exe' | 'facebook.com' | regex
  pattern     String
  displayName String       @map("display_name")
  category    Productivity
  priority    Int          @default(100)

  appUsage AppUsage[]

  @@map("app_categories")
}

// ══════════════════════════ events and audit ══════════════════════════

model Event {
  id         BigInt   @id @default(autoincrement())
  deviceId   Int?     @map("device_id")
  employeeId Int?     @map("employee_id")
  clientUuid String   @unique @map("client_uuid") @db.Uuid
  /// agent_start | agent_stop | logon | logoff | lock | unlock | sleep | resume
  /// agent_crash | clock_drift | screenshot_skipped | day_rollover | segment_split
  type       String
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  meta       Json?
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  device   Device?   @relation(fields: [deviceId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([employeeId, occurredAt])
  @@map("events")
}

/// There is no time_claims table: staff have no way to make a claim (ADR-011d).
/// This is a different thing: the owner gives back hours lost through the system's own fault (ADR-011e, § 2.1-e).
model TimeAdjustment {
  id              BigInt          @id @default(autoincrement())
  employeeId      Int             @map("employee_id")
  workDate        DateTime        @map("work_date") @db.Date
  /// + = hours given back · - = deducted
  deltaSec        Int             @map("delta_sec")
  cause           AdjustmentCause
  /// Mandatory: cannot be left empty
  reason          String
  evidenceAlertId BigInt?         @map("evidence_alert_id")
  /// Given more than the measured downtime? Shown separately in the report
  beyondEvidence  Boolean         @default(false) @map("beyond_evidence")
  /// Owner only
  createdById     Int             @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  /// No delete: only revoke, the record stays
  revokedAt       DateTime?       @map("revoked_at") @db.Timestamptz(3)
  revokedById     Int?            @map("revoked_by")
  revokeReason    String?         @map("revoke_reason")

  employee      Employee @relation(fields: [employeeId], references: [id])
  createdBy     User     @relation("AdjustmentCreatedBy", fields: [createdById], references: [id])
  revokedBy     User?    @relation("AdjustmentRevokedBy", fields: [revokedById], references: [id])
  evidenceAlert Alert?   @relation(fields: [evidenceAlertId], references: [id])

  @@index([employeeId, workDate])
  @@map("time_adjustments")
}

/// Which admin viewed whose screenshot and when: that is recorded too
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     Int?     @map("user_id")
  /// view_screenshot | export_report | change_setting | reset_password
  /// create_enrollment_code | revoke_device | upload_policy_doc
  /// time_adjustment | time_adjustment_revoke
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  ipAddress  String?  @map("ip_address") @db.Inet
  meta       Json?
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, occurredAt])
  @@map("audit_log")
}

model Setting {
  key         String   @id
  value       Json
  updatedById Int?     @map("updated_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("settings")
}

// ══════════════════ calendar ══════════════════
// Careful: leave_types / leave_requests / leave_balances do not exist, deliberately (ADR-011d).

/// Serves two purposes: marking days on the heatmap, and counting workdays for pace (§ 2.1-b).
/// Careful: not a block: if someone works on a holiday, those hours are counted in full.
model Holiday {
  id          Int      @id @default(autoincrement())
  holidayDate DateTime @unique @map("holiday_date") @db.Date
  name        String
  type        String   @default("public")
  /// The date is an estimate that may still move (a lunar-calendar holiday,
  /// one awaiting an official announcement). Reports and payroll list these
  /// dates beside the figures they affect; the owner clears it once confirmed.
  approximate Boolean  @default(false)

  @@map("holidays")
}

// ══════════════════ alerts and agent versions ══════════════════

model Alert {
  id               BigInt        @id @default(autoincrement())
  /// agent_down | agent_killed | disk_warning | disk_critical | backup_failed
  /// clock_drift | no_activity_today | device_overlap
  type             String
  severity         AlertSeverity
  employeeId       Int?          @map("employee_id")
  deviceId         Int?          @map("device_id")
  title            String
  detail           String?
  meta             Json?
  channelsSent     String[]      @map("channels_sent")
  acknowledgedById Int?          @map("acknowledged_by")
  acknowledgedAt   DateTime?     @map("acknowledged_at") @db.Timestamptz(3)
  // The server itself saw the condition clear (the agent came back), not a human.
  //    Different from acknowledgedAt ("a human saw it"): two different events, so two columns.
  //    NULL = not yet resolved; "open" means acknowledgedAt and resolvedAt are both NULL.
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz(3)
  resolvedReason   String?       @map("resolved_reason")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  employee       Employee?        @relation(fields: [employeeId], references: [id])
  device         Device?          @relation(fields: [deviceId], references: [id])
  acknowledgedBy User?            @relation(fields: [acknowledgedById], references: [id])
  adjustments    TimeAdjustment[]

  @@index([createdAt])
  @@map("alerts")
}

model AgentVersion {
  version      String       @id
  msiPath      String       @map("msi_path")
  sha256       String
  /// The owner's ECDSA signature of the MSI (base64 DER), from `<msi>.sig` at
  /// publish — passed on to agents that check it. null = published unsigned.
  signature    String?
  releaseNotes String?      @map("release_notes")
  rolloutStage RolloutStage @default(canary) @map("rollout_stage")
  /// **When the stage last changed** *(6 September 2026)*.
  ///
  /// Careful: the floor of the soak clock. Soak used to be measured only from
  /// `devices.agent_version_since`, i.e. when the device installed that build. That
  /// clock did NOT reset when the stage changed, so a machine that had spent six hours
  /// on canary would also push `partial -> all` on the very next tick, effectively
  /// skipping the 50% stage.
  stageChangedAt DateTime @default(now()) @map("stage_changed_at") @db.Timestamptz(3)

  /**
   * **The one PC that gets it first, regardless of bucket** *(1 September 2026)*.
   *
   * Careful: the rollout goes **by machine** (a hash of `machineGuid`), not by person.
   * So the PC where the bug was found could not be the first to test the fix. In the
   * owner's words: *"OX-05 ei update age powa dorkar"* (OX-05 needs to get this update
   * first), yet his bucket is 86, while canary is 7 and partial 50.
   *
   * Careful: on `halted` the pilot is excluded too: the emergency brake is for everyone.
   */
  pilotDeviceId Int?    @map("pilot_device_id")
  pilotDevice   Device? @relation("agentVersionPilot", fields: [pilotDeviceId], references: [id])
  isMandatory  Boolean      @default(false) @map("is_mandatory")
  releasedAt   DateTime     @default(now()) @map("released_at") @db.Timestamptz(3)

  @@map("agent_versions")
}

// ══════════════════ rollup: to make reports fast ══════════════════
// Refreshed every 15 minutes and at day close (00:15)

/// Careful: target / shortfall / overtime / late / attendance are not here:
///    there is no daily target at all. All target calculations live in MonthlySummary.
/**
 * **A task**: one work item in the pool, handed to one person.
 *
 * Coordinators, managers or the owner paste tasks in bulk; every morning they are
 * handed out at random to the people who receive tasks.
 *
 * Careful: **identity is `reference`**, and `@unique` is there: the same reference
 * pasted twice would give two people the same work.
 */
model Task {
  id        Int        @id @default(autoincrement())
  /// What the task is: free text up to 200 characters, trimmed, unique
  reference String     @unique @db.VarChar(200)
  /// Where the work item lives: an http(s) URL, or null
  link      String?    @db.VarChar(500)
  status    TaskStatus @default(pool)

  /**
   * The task number, given when the task is added: the assignee puts it at the
   * start of the window title (`1000042 - Quarterly report.docx`), and that is how
   * "started" is detected.
   *
   * Careful: it starts at **1,000,000** (`task_number_seq`), so it never collides with
   * the short numbers people already put at the start of file names.
   */
  taskNumber Int? @unique @map("task_number")

  /// Careful: who added it: a coordinator, manager or the owner
  addedById Int      @map("added_by_id")
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  assignedToId Int?      @map("assigned_to_id")
  assignedAt   DateTime? @map("assigned_at") @db.Timestamptz(3)

  /**
   * **Work has started**: the task number was first seen at the start of a window
   * title in one of the start-detection apps.
   *
   * Careful: **"started" and "finished" are not the same.** The agent sees the number
   * the moment the window **comes to the front**, i.e. at the start of work. Treating
   * that as "finished" would close the task as soon as it is opened. So the automatic
   * signal goes here, and **the assignee says it is finished** (the Complete button).
   */
  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  /**
   * **Who said "finished"**.
   *
   * Careful: `completedVia` says **how** it happened (`manual` / `filename`), this says
   * **who**: the owner may press Complete on someone's behalf, and the list must not
   * show the assignee's name for it.
   *
   * Linked to `User`, not `Employee`: on both paths (the assignee's own page and the
   * owner's list) the one who presses is a logged-in user.
   */
  completedById Int?    @map("completed_by_id")
  completedBy   User?   @relation("taskCompletedBy", fields: [completedById], references: [id])

  /**
   * **The owner/manager has looked over the dropped row**.
   *
   * Careful: **`NULL` means it is in the queue**, and that is the queue's only condition
   * (along with `dropReason != null`). Without this marker the list would never become
   * empty.
   *
   * Careful: sending it back to the pool clears this too: the row is then no longer
   * dropped, so "looked over" has no subject any more.
   */
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewedById Int?      @map("reviewed_by_id")
  reviewedBy   User?     @relation("taskReviewedBy", fields: [reviewedById], references: [id])

  /// **Checked** (the optional QA step).
  ///
  /// Careful: **a date, not a state**, like `delivered_at`/`published_at`. A new state
  /// would move the row away from `done`, and every "how many tasks are done" count in
  /// the whole system would silently drop.
  ///
  /// Careful: `null` = **not checked yet**, not "no problems": those are two different things.
  checkedAt    DateTime? @map("checked_at") @db.Timestamptz(3)
  checkedById  Int?      @map("checked_by_id")
  checkedBy    User?     @relation("taskCheckedBy", fields: [checkedById], references: [id])

  /// **A problem was found**: `null` means it was checked and was fine
  /// (if `checked_at` is set), or has not been checked yet.
  errorFoundAt DateTime? @map("error_found_at") @db.Timestamptz(3)

  /// **The problem has been fixed**.
  ///
  /// Careful: `assigned_to_id` **never changes**: the task stays with the original
  /// assignee. Otherwise the work would pass to whoever fixed it.
  fixedAt      DateTime? @map("fixed_at") @db.Timestamptz(3)
  fixedById    Int?      @map("fixed_by_id")
  fixedBy      User?     @relation("taskFixedBy", fields: [fixedById], references: [id])
  /**
   * **Delivered** (optional post-completion stage).
   *
   * Careful: **a date, not a new state**, just like `startedAt`/`completedAt`.
   * Put in `status`, a piece of work would go from "done" to "delivered", and every
   * count based on `status = 'done'` would silently drop. Kept as a date, **all the
   * stages stay true together**, and you can also tell when each happened.
   */
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  /**
   * **Published**: the last stage, after delivery.
   *
   * Careful: delivered and published are not the same: whoever receives the work may
   * still review or reject it. Keeping them apart shows where the pipeline leaks.
   */
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  /**
   * An optional reference for the **published result** (an order number, a URL, an
   * id in another system).
   *
   * Careful: do not confuse it with `reference` above: that is what the task was about;
   * this is what came out of it.
   */
  publishedRef String?  @map("published_ref") @db.VarChar(200)
  /**
   * **The last thing that happened**: the basis for list order and the date filter.
   *
   * Careful: **computed in the database** (`GENERATED ALWAYS AS ... STORED`): code never
   * writes to it, and PostgreSQL itself blocks any attempt. So there can be no state
   * of "someone forgot to update it".
   *
   * `GREATEST` ignores NULL, and `addedAt` is NOT NULL, so the column is never empty,
   * even on a row sitting in the pool.
   *
   * Careful: it is written optional (`?`) in Prisma so that no `create` treats it as
   * required: in the real database the column is never NULL.
   */
  lastActivityAt DateTime? @default(dbgenerated("GREATEST(added_at, assigned_at, started_at, completed_at, checked_at, fixed_at, delivered_at, published_at)")) @map("last_activity_at") @db.Timestamptz(3)
  /// `filename` (detected automatically) or `manual` (the person said so)
  completedVia String? @map("completed_via") @db.VarChar(16)

  /**
   * **Why the row went away**: `not_needed` · `cannot_do` · `duplicate` · `other`.
   *
   * Careful: **one column, two paths:** the assignee's Skip and the owner's Delete both
   * write here. Which path was taken is told by `status`, so the reason need not be kept
   * twice.
   *
   * Careful: **the machine value is stored, not the screen text** (`not_needed`, not
   * "No longer needed"): otherwise if the wording changed one day, all the old rows would
   * mean something else. The list is in one place: `DROP_REASONS` in `tasks.rules.ts`.
   */
  dropReason String? @map("drop_reason") @db.VarChar(16)

  /**
   * **Where this row came from before oXeio**, as free text from an import.
   *
   * Careful: names of people who are not staff rows could NOT go into `assignedToId`
   * (the FK is tied to employee rows), but they are not thrown away either: the raw
   * text stays here.
   *
   * Careful: `null` means the row was born in oXeio itself, not imported.
   */
  sourceNote String? @map("source_note")

  addedBy    User      @relation("addedTasks", fields: [addedById], references: [id])
  assignedTo Employee? @relation(fields: [assignedToId], references: [id])

  /// For picking from the pool at hand-out time: `WHERE status = 'pool'`
  @@index([status])
  /// The assignee's own list
  @@index([assignedToId, status])
  @@index([completedById])
  /// List order: latest activity first
  @@index([lastActivityAt(sort: Desc)])
  @@index([assignedToId, lastActivityAt(sort: Desc)])
  @@map("tasks")
}

/**
 * **When a task number was first seen on screen** (start detection, Tasks module).
 *
 * Careful: **why a separate table, rather than counting every day.** The honest answer
 * to "how many tasks were started today" is the number of **new** numbers: bringing
 * yesterday's window back to the front today is not a new start. But knowing whether
 * something is "new" needs the **whole history**, and scanning that every day would get
 * expensive after a year.
 *
 * So each (employee, number) pair goes in **only once**, and the primary key does not
 * let it go in a second time. "How many today" = rows whose `first_work_date` is today.
 *
 * Careful: **the window title is not stored here**, only the leading number. Titles
 * may be read for the configured apps, but never kept or shown.
 */
model TaskCredit {
  employeeId    Int      @map("employee_id")
  /// The number at the start of the window title, such as `1000042`
  taskNumber    String   @map("task_number") @db.VarChar(16)
  /// The work day on which this was **first** seen
  firstWorkDate DateTime @map("first_work_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@id([employeeId, taskNumber])
  @@index([employeeId, firstWorkDate])
  @@map("task_credits")
}

model DailySummary {
  employeeId      Int       @map("employee_id")
  workDate        DateTime  @map("work_date") @db.Date
  firstActivityAt DateTime? @map("first_activity_at") @db.Timestamptz(3)
  lastActivityAt  DateTime? @map("last_activity_at") @db.Timestamptz(3)
  activeSec       Int       @default(0) @map("active_sec")
  /// Lunch / tea / breaks are all in here: they are not tracked separately (ADR-011)
  idleSec         Int       @default(0) @map("idle_sec")
  /// The UNION of actual ACTIVE time (§ 2.1-c): this number is never edited
  workedSec       Int       @default(0) @map("worked_sec")
  /// Presence: active stretches joined across pauses up to the policy's gap. Stored for every
  /// policy; it is what `credited_sec` counts only when the policy's measure is `presence`
  presenceSec     Int       @default(0) @map("presence_sec")
  /// The owner's correction, +/- (§ 2.1-e)
  adjustmentSec   Int       @default(0) @map("adjustment_sec")
  /// worked + adjustment: this is what goes into the monthly target
  creditedSec     Int       @default(0) @map("credited_sec")
  /// The first and last active hour of the day (0-23): information only, not a yardstick for judgement
  earliestHour    Int?      @map("earliest_hour") @db.SmallInt
  latestHour      Int?      @map("latest_hour") @db.SmallInt
  productiveSec   Int       @default(0) @map("productive_sec")
  unproductiveSec Int       @default(0) @map("unproductive_sec")
  productivityPct Decimal?  @map("productivity_pct") @db.Decimal(5, 2)
  screenshotCount Int       @default(0) @map("screenshot_count")
  /**
   * **How many tasks were started today**: task numbers first seen at the start of a
   * window title that day ([TaskCredit]), only while start detection is on.
   *
   * Careful: this is "started", not "done"; finished counts come from
   * `tasks.completed_at`. Always 0 when start detection is off.
   */
  tasksStarted    Int       @default(0) @map("tasks_started")
  dayType         DayType?  @map("day_type")
  computedAt      DateTime  @default(now()) @map("computed_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@id([employeeId, workDate])
  @@map("daily_summary")
}

/// The main reporting table: the only yardstick is here
/**
 * **Old salaries** *(23 August 2026)*: so past payroll does not move.
 *
 * Careful: **why this was needed.** [R1](../../docs/history/10-Roadmap.md) closes a month and
 * so protects the *hours*: `refreshMonth()` no longer touches a closed month. But
 * payroll takes the salary figure from `employees.monthly_salary`, **live**. So when
 * someone's salary was raised, **a closed month's payroll would silently change
 * too**, and no longer match the paper the salary was paid from.
 *
 * **R1 deliberately left out a snapshot table**: *"copying a number means keeping the
 * same number in two places, and then the question 'which is true' is open forever"*.
 * This table does not make that mistake, because **there is no overlap**:
 *
 * | Question | Where the answer is |
 * |---|---|
 * | What is the salary now? | `employees.monthly_salary`: a single column |
 * | What was it in 2026-07? | The row here, if there is one |
 *
 * Careful: a row goes in **only when the salary changes**: the old value, together
 * with "up to which month it applied". With no change the table is empty, and payroll
 * reads from the employee's column as before. So **nothing that has not changed has a
 * copy**.
 */
model SalaryPeriod {
  id            Int      @id @default(autoincrement())
  employeeId    Int      @map("employee_id")
  /**
   * 'YYYY-MM': **this salary applied up to and including this month**.
   *
   * Careful: "up to which month", not "since when": the question is always about the
   *    past ("what was it in July?"), and written this way the row with the smallest
   *    `through_month >= that month` is the answer. Storing "since when" would leave an
   *    open-ended range after the last row, and it would collide with the current salary.
   */
  throughMonth  String   @map("through_month") @db.Char(7)
  payBasis      PayBasis @default(monthly) @map("pay_basis")
  monthlySalary Decimal? @map("monthly_salary") @db.Decimal(12, 2)
  hourlyRate    Decimal? @map("hourly_rate") @db.Decimal(12, 2)
  /// Who changed it and why: the audit has a row, but on the payroll screen this is closer to hand
  note          String?
  changedById   Int?     @map("changed_by_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  /// Careful: with two rows for the same employee and the same month, "which is true" would be back
  @@unique([employeeId, throughMonth])
  @@index([employeeId])
  @@map("salary_periods")
}

model MonthlySummary {
  employeeId       Int       @map("employee_id")
  /// '2026-08'
  yearMonth        String    @map("year_month") @db.Char(7)
  /// Raw figures
  workedSec        Int       @default(0) @map("worked_sec")
  adjustmentSec    Int       @default(0) @map("adjustment_sec")
  /// worked + adjustment: this is what is matched against the target
  creditedSec      Int       @default(0) @map("credited_sec")
  /// The month's target (176 hours = 633600 by default; the real value is always written)
  targetSec        Int       @default(633600) @map("target_sec")
  /// How much should have been done up to today (§ 2.1-b)
  expectedSec      Int       @default(0) @map("expected_sec")
  /// credited - expected · positive = ahead
  paceSec          Int       @default(0) @map("pace_sec")
  /// **Their own** workdays (d): how many fall between joined_on and left_on.
  /// Careful: before G37 this was "the month's total workdays"; the meaning has changed (ADR-025).
  expectedWorkdays Int       @map("expected_workdays")
  /// The month's total workdays (D): the denominator of the salary fraction d / D.
  /// Careful: stored separately, not counted again at payroll time: if the holiday list
  /// changed, d and D would be calculations from two different times, and the fraction
  /// would be wrong.
  monthWorkdays    Int       @default(0) @map("month_workdays")
  /// R2: approved-leave workdays. Lowers the target, does not touch `d / D`.
  leaveWorkdays    Int       @default(0) @map("leave_workdays")
  /// How many workdays have passed up to today
  workdaysElapsed  Int       @default(0) @map("workdays_elapsed")
  /// The number of workdays actually **seen**, i.e. whose `daily_summary` row was
  /// written *(6 September 2026)*.
  ///
  /// Careful: the difference from `workdays_elapsed` is the whole point: that one counts
  /// the **calendar**, so days when the system was down still counted in full as expected.
  /// Salary shortfall is now measured against **this one**: the owner's decision, 6
  /// September: *"no deduction for days not seen"*.
  observedWorkdays Int       @default(0) @map("observed_workdays")
  daysWithWork     Int       @default(0) @map("days_with_work")
  avgDailySec      Int       @default(0) @map("avg_daily_sec")
  overtimeSec      Int       @default(0) @map("overtime_sec")
  shortfallSec     Int       @default(0) @map("shortfall_sec")
  targetMet        Boolean   @default(false) @map("target_met")
  targetMetAt      DateTime? @map("target_met_at") @db.Timestamptz(3)
  computedAt       DateTime  @default(now()) @map("computed_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@id([employeeId, yearMonth])
  @@map("monthly_summary")
}

/**
 * R1: **closing a month.**
 * Careful: the problem this fixes: every figure in `monthly_summary` is **recounted
 * from scratch** by `refreshMonth()` each time, and the count reads the `holidays` table
 * of that moment. So when a holiday date moved, or a time adjustment for an old month was
 * approved, **all four of last month's `target_sec`, `expected_sec`, `expected_workdays`
 * (d) and `month_workdays` (D) changed retroactively**. Payroll reads d and D from that
 * row, so the figures could move even after salary was paid, with no way to prove which
 * figures the salary was based on.
 * **A row here, not figures.** The roadmap said "snapshot table", but that would create
 * **two** figures for the same month, live and frozen, and "two figures on two screens"
 * is this repo's biggest sin (G88). Instead the figures are **frozen in place** in
 * `monthly_summary`: while a month is closed `refreshMonth()` no longer touches it, and
 * an adjustment trying to enter gets a 409.
 * This table is only the record of **who closed it and when**.
 * The key is only `year_month`: a month is closed for everyone at once, not one person
 * at a time. If it could be closed per employee, the answer to "is August closed?"
 * would be "for whom?", and payroll runs over the whole month.
 */
/// **The workday that needs recounting** *(6 September 2026)*.
///
/// Careful: **why this table was needed:** the rollup ran over only **two** days:
/// today (K06, every 15 minutes) and yesterday (K05, once at 00:15). If a segment for
/// any other day arrived later, it landed in `activity_segments` fine but **never made
/// it** into `daily_summary`, and so not into the monthly row, and so not into salary.
///
/// This is not rare but everyday: when a PC is shut down in the evening, the last
/// segment stays in the outbox and uploads the next morning after login, by which time
/// the 00:15 day-close has passed. Measured in the field: in August-September **39
/// (employee, day) pairs, 17.78 hours** were lost this way.
///
/// The row is **per day, not per employee**: `refreshDate()` writes the rows of all
/// active employees for that day at once, so a per-employee marker would repeat the
/// same work.
model SummaryDirty {
  /// The work-zone workday, written as UTC midnight (`workDateOf()`)
  workDate DateTime @id @map("work_date") @db.Date
  /// When it was first marked: this is the drain order (oldest first)
  markedAt DateTime @default(now()) @map("marked_at") @db.Timestamptz(3)

  @@index([markedAt])
  @@map("summary_dirty")
}

model MonthClosure {
  /// '2026-08'
  yearMonth String   @id @map("year_month") @db.Char(7)
  closedAt  DateTime @default(now()) @map("closed_at") @db.Timestamptz(3)
  /// Careful: email, not `user_id`: even if the user is deleted, "who closed it" must survive
  closedBy  String   @map("closed_by")
  /// Why, or on what basis: optional
  note      String?

  @@map("month_closures")
}

/**
 * R2: **the leave book.**
 * Careful: **no application-approval flow**: "no button for staff to press" is this
 * system's declared rule. Staff say it aloud, the owner writes it down. So there is no
 * `status`/`approvedBy` column here, and there should not be.
 * **One row = one day**, not a date range. The screen takes a range ("3-7 August") and
 * breaks it into days. Because then counting, excluding, and deleting a single day are
 * all trivial; keeping ranges would mean handling overlaps and partial intersections in
 * every calculation, and bugs would be born right there.
 * **Leave lowers the hours target, not the salary**, i.e. it is **paid**.
 * `monthly_summary.expected_workdays` (d) stays unchanged, so payroll's `d / D` fraction
 * stays intact too. Only `target_sec` and `expected_sec` go down.
 * Careful: the opposite (lowering d) would mean quietly deducting salary whenever leave
 * is taken, which cannot be done without the owner's conscious decision.
 * Careful: if someone works on a leave day the hours **are counted**: leave waives the
 * target, it does not forbid work (the rule of § 2.1-b is the same on leave).
 */
model Leave {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  /// The work-zone workday: UTC midnight, just like `holidays.holiday_date`
  leaveDate  DateTime @map("leave_date") @db.Date
  /// `casual` · `sick` · `annual`: **all three are paid**
  ///
  /// Careful: `unpaid` is deliberately **absent**. Unpaid leave would lower d (the
  /// numerator of `d / D`), yet all the code here treats leave as paid. Keeping the
  /// name would leave `unpaid` in the book while no salary was deducted: the figure
  /// would claim something it does not know. If needed, that is a separate payroll decision.
  type       String   @default("casual")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Careful: email, not `user_id`: even if the user is deleted, "who wrote it" must survive
  createdBy  String   @map("created_by")

  employee Employee @relation(fields: [employeeId], references: [id])

  /// Leave cannot be written twice on the same day, otherwise it would be excluded twice in the count
  @@unique([employeeId, leaveDate])
  @@index([leaveDate])
  @@map("leaves")
}

/**
 * R21: **security money (deposit): the rule.**
 * **Just one row** (`id = 1`). The amount is the same for everyone: the owner's
 * decision, 15 August. If it could differ per employee, a single column in `employees`
 * would have been enough, but then the answer to "how much for whom" would be spread over
 * 12 places, and when one person's cell was empty there would be no way to tell whether
 * it meant "zero" or "default".
 * Careful: **changing the amount here does not change old instalments**: each month's
 * instalment is **written down** in `security_deposits`, not recounted every time. The
 * other way round, raising 500 to 600 today would retroactively raise the last six
 * months' deposits too, and the ledger would claim money the employee never paid.
 */
model DepositPolicy {
  /// Careful: always 1: the way to more than one row is closed (not `@default(1)`; code sets it)
  id             Int      @id
  /// How much each month, **in minor units** (hundredths): 500.00 = 50000
  amountMinor    Int      @map("amount_minor")
  /// From which month deduction starts: '2026-08'
  startYearMonth String   @map("start_year_month") @db.Char(7)
  /// How many days' notice must be given before leaving: if less, the deposit is forfeited
  noticeDays     Int      @default(30) @map("notice_days")
  /// Careful: when switched off, new instalments stop, **old deposits stay intact**
  active         Boolean  @default(true)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Careful: email, not `user_id`: even if the user is deleted, "who changed it" survives
  updatedBy      String   @map("updated_by")

  @@map("deposit_policy")
}

/**
 * R21: **the deposit ledger: one row = one employee's instalment for one month.**
 * Why it is **written down** rather than calculated: a deposit is a **history of
 * events**, not the result of today's rule. If someone changes the amount after six
 * months, someone joins midway, or someone's month is skipped, a calculation-based
 * ledger would give a different answer every time, and there would be no way to say
 * which is true.
 * `amount_minor` is on **every row**, not looking at the rule. That is the real trick
 * for preserving history.
 * Careful: rows go in **from the start month up to the current month**, and not for any
 * month before the employee joined (`joined_on`). Once inactive, none go in after that.
 */
model SecurityDeposit {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  /// '2026-08'
  yearMonth   String   @map("year_month") @db.Char(7)
  /// How much was deducted that month, in minor units. Careful: this does not change even if the rule changes
  amountMinor Int      @map("amount_minor")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  /// An instalment cannot go in twice in the same month: the ledger is built idempotently
  @@unique([employeeId, yearMonth])
  @@index([yearMonth])
  @@map("security_deposits")
}

/**
 * R21: **settlement: refund or forfeit.**
 * Careful: **the system does not make the decision, the owner does** (his decision, 15
 * August). The system only gives the figures: how many days' notice were given, how many
 * the rule needs, and how much money has accumulated. Because exceptions always exist
 * (hospital, family reasons) and no `if` can capture them. Automating it would force the
 * owner to **break** the rule, with no way to break it.
 * `notice_days` is **written here too**, so that even if the rule changes later, it can
 * be read under which rule this settlement was made.
 */
model DepositSettlement {
  id              Int       @id @default(autoincrement())
  employeeId      Int       @map("employee_id")
  /// `refunded` · `forfeited`
  outcome         String
  /// The deposit amount at settlement, in minor units. Careful: this stays intact even if the ledger changes later
  amountMinor     Int       @map("amount_minor")
  /// When notice was given
  noticeGivenOn   DateTime? @map("notice_given_on") @db.Date
  /// Last working day
  lastWorkingDay  DateTime? @map("last_working_day") @db.Date
  /// How many days' notice was given (calculated), and how many the rule required
  noticeDaysGiven Int?      @map("notice_days_given")
  noticeDaysRule  Int       @map("notice_days_rule")
  note            String?
  settledAt       DateTime  @default(now()) @map("settled_at") @db.Timestamptz(3)
  /// Careful: email, not `user_id`
  settledBy       String    @map("settled_by")

  employee Employee @relation(fields: [employeeId], references: [id])

  /// One settlement per person: if they come back, the ledger starts afresh, and
  /// that decision belongs to that time, not to today
  @@unique([employeeId])
  @@map("deposit_settlements")
}
