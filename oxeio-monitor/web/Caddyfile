# The dashboard and the API share ONE origin: that is the whole reason for this file.
#
# Careful: to the browser `/api/v1/...` is a relative path (`web/src/api/client.ts`),
#    and the session cookie is `SameSite=Strict`. With two different origins (say
#    dashboard :8080, API :3000) login would look successful but the very next request
#    would be a 401. We fell into exactly this trap once in dev mode, and it is why a
#    proxy had to be set up in Vite ([09 § ৩.৫](../../docs/09-Build-Log.md)).
#
# CORS never comes up. `CORS_ORIGIN` then only exists for some other client, not
#    for the dashboard.

# The site address comes from an ENVIRONMENT VARIABLE: no need to edit the file.
#
#   With nothing set it is `:8080`: the office LAN and dev behave as before.
#   With `CADDY_SITE=monitor.oxeio.com`, Caddy itself listens on 80 and 443 and
#   **gets and renews the Let's Encrypt certificate** too: no certbot needed.
#
# Careful: with a domain, DNS must be set up first (A record -> the VPS's IP).
#   Without it Let's Encrypt cannot validate, and Caddy keeps trying and failing.

# Careful: `rate_limit` is NOT a standard Caddy directive (it is a plugin, see
#    `Dockerfile`). For a non-standard directive Caddy does not know in what order to
#    run it, so the order must be stated here, otherwise there is a plain error at
#    startup. It goes before `reverse_proxy`, so requests over the limit never reach
#    the API.
{
	order rate_limit before reverse_proxy

	# ── Behind another proxy (Traefik, Nginx, Cloudflare, Coolify ...) ──
	# Empty by default: Caddy is the edge, exactly as before, and
	# {client_ip} below is the same as {remote_host}.
	#
	# Behind another proxy, list ITS addresses (CIDR, space-separated) in
	# CADDY_TRUSTED_PROXIES. Only for requests from those addresses does
	# Caddy believe the client IP header; everyone else keeps their own IP,
	# so nobody can pick an IP by sending the header themselves.
	#   CADDY_TRUSTED_PROXIES=172.16.0.0/12          # e.g. a docker network
	#   CADDY_CLIENT_IP_HEADERS=CF-Connecting-IP     # Cloudflare in front
	# deploy/README.md § "Behind a reverse proxy".
	servers {
		trusted_proxies static {$CADDY_TRUSTED_PROXIES}
		client_ip_headers {$CADDY_CLIENT_IP_HEADERS:X-Forwarded-For}
	}
}

{$CADDY_SITE::8080} {
	root * /srv
	encode gzip

	# ── API ───────────────────────────────────────────────────────────────
	# Careful: the name `api` is the docker compose service name; it works as DNS
	#    inside the same network. Traffic never leaves the host.
	handle /api/* {
		#  R6 / G116: a login flood is stopped at the edge.
		#
		#  Careful: the limit is ONLY on `POST /api/v1/auth/login`, not on all of `/auth/*`.
		#     `GET /auth/me` and `GET /auth/session-policy` also live under that path,
		#     and they are called on EVERY page load; a limit on the whole prefix would
		#     get the office itself stuck on 429s. The routes were counted before this
		#     was written (`auth.controller.ts`: 11 routes, the two GETs the busiest).
		#
		#  Careful: 30/minute is deliberately loose: the whole office is behind one IP.
		#     On a password-reset day seven people can easily make 20+ attempts in a
		#     minute; with 20 that day would grind to a halt.
		#
		#  The two layers stop two different things, and that is the design:
		#       - here (the edge): RATE, no more than 30 a minute, saves CPU
		#       - in the app (`login-throttle.service.ts`): COUNTING, after 50 wrong
		#         attempts that IP is locked out, whatever the email (G116)
		#     Neither is complete without the other: the edge limit does NOT count
		#     wrong passwords, and the app's count LETS the request in.
		#
		#  Careful: `{remote_host}` = the client's direct IP. If Cloudflare or another
		#     proxy is ever put in front, it becomes THEIR IP, and then the whole world
		#     falls into one bucket; then `trusted_proxies` and `X-Forwarded-For`
		#     must be set up.
		#
		#  Update: the key is now `{client_ip}` — the same as `{remote_host}`
		#  unless CADDY_TRUSTED_PROXIES is set (top of this file), and the
		#  real visitor's IP when it is.
		rate_limit {
			zone login {
				match {
					method POST
					path /api/v1/auth/login
				}
				key {client_ip}
				events 30
				window 1m
			}
		}

		reverse_proxy api:3000 {
			# The API trusts exactly one hop (TRUST_PROXY=1, app.setup.ts):
			# this one. So the client IP is decided here, once, from
			# CADDY_TRUSTED_PROXIES, and handed over as a single value —
			# never a chain the API would have to count hops in. With no
			# trusted proxies this is {remote_host}, as Caddy sent before.
			header_up X-Forwarded-For {client_ip}

			# Careful: if you turn on TLS in the API (deploy/README § ৬), uncomment this
			#    block, otherwise Caddy will send plain HTTP and every request dies.
			#    The certificate is self-signed, so verification is skipped; the
			#    connection stays inside the host.
			# transport http {
			# 	tls
			# 	tls_insecure_skip_verify
			# }
		}
	}

	# ── SPA ───────────────────────────────────────────────────────────────
	# Careful: try_files is mandatory: routing is on the client (react-router), so
	#    opening `/monthly` or `/staff/7` directly finds no such file on disk.
	#    Without it a refresh would give a 404, and that would be found on rollout day.
	handle {
		try_files {path} /index.html
		file_server
	}

	# Careful: images and reports can be large; the default limit would block them.
	request_body {
		max_size 25MB
	}

	header {
		# Caching: never for index.html (otherwise the old app would keep running after
		# an update), forever for hashed assets.
		?Cache-Control "no-cache"
		-Server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# ── PWA ───────────────────────────────────────────────────────────────
	# The service worker must NEVER be cached: this is the most important line in
	#    this file, and the one whose mistake is found last.
	#
	# Careful: the browser learns whether a new version exists ONLY by downloading
	#    `/sw.js` again. If the file were cached it would read the old copy, see "same
	#    as before", and the update would NEVER arrive: the deploy would look
	#    successful while phones ran the old app for months. The only way out of this
	#    trap is wiping the site data by hand on the user's phone.
	#
	# The `?Cache-Control "no-cache"` above would already give this (`?` = "only if
	#    nobody else did"). It is still written separately: `no-store` is added, and
	#    if someone later changes the default this rule survives.
	# Careful: the `/assets/*` immutable rule does not apply to `/sw.js`: the worker
	#    deliberately sits at the site ROOT (in `assets/` its scope would be
	#    `/assets/` and it would never catch navigations).
	@sw path /sw.js
	header @sw Cache-Control "no-cache, no-store, must-revalidate"

	# Careful: the manifest and icons also stay on the default `no-cache` (the `?`
	#    rule). They get no hash: the name does not change, only the content does.
	#    Making them immutable would leave the old icon in place after a logo change,
	#    and that is what the home screen shows. The files are small and revalidation
	#    returns a 304, so the cost is almost zero.

	# Careful: the MIME type of `.webmanifest` must be set BY HAND. Caddy takes types
	#    from Go's `mime.TypeByExtension`, and Go's built-in list does not have that
	#    extension; `caddy:2-alpine` has no `/etc/mime.types` either. So the file would
	#    be sniffed as `text/plain`. Chrome does not check the MIME type today, so it
	#    installs anyway, but that is not something to rely on: one line makes it certain.
	#    After a deploy: `curl -I https://hub.oxeio.com/manifest.webmanifest`
	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"
}
