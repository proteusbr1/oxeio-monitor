<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI for the oXeio agent (H03).

  Silent install: clicking through every PC one by one is out of the question:

    msiexec /i oXeioAgent-0.3.0.msi /qn SERVERURL="https://monitor.example.com" ^
            ENROLLCODE="OXEIO-XXXXXXXX"

  Uninstall:

    msiexec /x oXeioAgent-0.3.0.msi /qn

  Careful: uninstalling does NOT delete %ProgramData%\oXeio. It may hold data that
  has not reached the server yet; removing the agent must not mean deleting
  someone's hours from last week. Delete the folder by hand, knowingly.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!-- Careful: Codepage 65001 (UTF-8) lets the messages below use any character.
       With the MSI default codepage 1252, a character outside it (such as a
       non-Latin translation) stops the build (WIX0311). -->
  <Package
      Name="oXeio Agent"
      Manufacturer="oXeio"
      Version="$(var.Version)"
      UpgradeCode="7A1E4C2B-9D33-4E51-8F0A-2C6B5D9E1A47"
      Scope="perMachine"
      Compressed="yes"
      Language="1033"

      Codepage="65001">

    <!-- Block upgrades by the same or an older version. Otherwise a rollout script
         that mistakenly ran an old MSI would leave some PCs in the fleet behind. -->
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of oXeio Agent is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!--
      Brand icon in the "Add or remove programs" list.

      Nothing was set before, so Windows showed a blank white page there. An admin
      could only find the entry by name, not by look.

      Careful: the `Id` of the `Icon` element MUST have the `.ico` extension, otherwise
      Windows Installer does not recognise the file as an icon and silently shows a
      blank one, with no build error.
    -->
    <Icon Id="oxeio.ico" SourceFile="oxeio.ico" />
    <Property Id="ARPPRODUCTICON" Value="oxeio.ico" />

    <!-- ── Values passed at install time ─────────────────────────────────────
         Careful: without Secure="yes" the values would not reach the elevated part.
            A silent install would write empty registry values, and the agent would
            sit there saying "not configured". -->
    <!--
      <b>The server address can be baked into the MSI at build time</b>
      (`build.ps1 -ServerUrl https://monitor.example.com`). Then it
      **installs on a double-click**, no command line needed.

      Why this was needed: installing on every PC meant typing a long
      `msiexec` command each time, so one typo = one dead machine, and the mistake
      showed up a week later as "its data is not coming in".

      Careful: `SERVERURL=` on the command line wins (the Property's Value is only a
      default), so the scripted rollout path is intact.
    -->
<?if $(var.ServerUrlDefault) = "" ?>
    <Property Id="SERVERURL" Secure="yes" />
<?else?>
    <Property Id="SERVERURL" Secure="yes" Value="$(var.ServerUrlDefault)" />
<?endif?>

    <!--
      Careful: ENROLLCODE has no default, and should not have one. The code is
      single-use; baked into the MSI it would already be dead on the second PC.
      Installing without a code makes the agent show the staff member the sign-in
      window (`SignInForm`), which is now the normal path.
    -->
    <Property Id="ENROLLCODE" Secure="yes" />
    <Property Id="PORTALURL" Secure="yes" />
    <Property Id="POLICYURL" Secure="yes" />

    <!--
      **I01**: SPKI hash (base64) of the server certificate, comma-separated.
      `deploy/make-cert.ps1` prints the value.

      Careful: several pins can be given, and when the key changes you must. If
      the old and the new one are not both valid for a while, the fleet loses its
      connection the moment the certificate is replaced (deploy/README.md ›
      "LAN install with a self-signed certificate", "Changing the key").
      Careful: if none is given, pinning is off, and the agent says so clearly in its
      log.
    -->
    <Property Id="SERVERPIN" Secure="yes" />

    <!--
      The owner's public key for agent updates (ECDSA P-256, base64 on one
      line). With it, the agent installs an update only if the MSI carries the
      owner's signature, not just a hash from the server. See deploy/README.md
      › "Signed agent updates".

      Baked in by `build.ps1 -UpdatePublicKey`, so every MSI the owner builds
      carries it and an update can never drop it. Empty = sha256 only, as before.
    -->
<?if $(var.UpdateKeyDefault) = "" ?>
    <Property Id="UPDATEKEY" Secure="yes" />
<?else?>
    <Property Id="UPDATEKEY" Secure="yes" Value="$(var.UpdateKeyDefault)" />
<?endif?>

    <!-- Installing without a server address makes no sense: the agent would be
         installed, run, and send nothing. Better to stop right at the start. -->
    <!--
      Careful: `Installed OR` must not be removed.

      On a major upgrade MSI runs TWO sessions: installing the new one, and removing the
      old one with `REMOVE=ALL`. The second session has no SERVERURL, so the condition
      would fail there and abort the whole transaction with 1603. For the same reason a
      plain `msiexec /x` would also be blocked, so the product could never be uninstalled.

      Found while upgrading on a real machine ([G58](../../../docs/08-Gap-Analysis.md)).
    -->
    <Launch
        Condition="Installed OR SERVERURL"
        Message="This MSI was built without a server address. Install it with: msiexec /i oXeioAgent-&lt;version&gt;.msi /qn SERVERURL=&quot;https://monitor.example.com&quot; — or rebuild it with build.ps1 -ServerUrl &quot;https://monitor.example.com&quot; so it installs on a double-click." />

    <!-- Windows 10 1809 (build 17763): the agent's minimum target -->
    <Launch
        Condition="Installed OR (VersionNT &gt;= 603)"
        Message="oXeio Agent requires Windows 10 or later." />

    <!-- ── Files and folders ─────────────────────────────────────────────── -->

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="oXeio" />
    </StandardDirectory>

    <!-- ── Configuration lives in the registry, not in a file ───────────────
         Because Windows removes it itself on uninstall, and there are no file ACLs to
         worry about. Nothing secret is here: the device token is in a separate file
         protected with DPAPI.
         Careful: the enrollment code is single-use, so once enrolled it is useless
            even if it stays behind. -->
    <ComponentGroup Id="Configuration" Directory="INSTALLFOLDER">
      <Component Id="SettingsRegistry" Guid="3D9B6C12-8E44-4FA0-9035-5C7E9B4DAF86">
        <RegistryKey Root="HKLM" Key="SOFTWARE\oXeio\Agent" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="ServerUrl" Type="string" Value="[SERVERURL]" KeyPath="yes" />
          <RegistryValue Name="EnrollmentCode" Type="string" Value="[ENROLLCODE]" />
          <RegistryValue Name="StaffPortalUrl" Type="string" Value="[PORTALURL]" />
          <RegistryValue Name="PolicyUrl" Type="string" Value="[POLICYURL]" />
          <RegistryValue Name="ServerPin" Type="string" Value="[SERVERPIN]" />
          <RegistryValue Name="UpdatePublicKey" Type="string" Value="[UPDATEKEY]" />
          <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <!-- ── .NET runtime and native libraries ────────────────────────────────
         Both exes are self-contained, so ~267 files go with them (runtime,
         SkiaSharp's native DLL, WinForms). Writing the list by hand is impossible: if
         one DLL were missed the agent would not start, and the mistake would only show
         up on a staff PC.

         Careful: both exes come in here too. The custom actions call them by path via
         [INSTALLFOLDER], not by FileRef; otherwise the same file would be declared
         twice. -->
    <ComponentGroup Id="RuntimeFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <Feature Id="Main" Title="oXeio Agent" Level="1">
      <ComponentGroupRef Id="Configuration" />
      <ComponentGroupRef Id="RuntimeFiles" />
    </Feature>

    <!-- ══ Custom actions ═══════════════════════════════════════════════════ -->

    <!--
      The data folder is created by the agent itself.

      With ProgramData's default ACL, a normal user can only modify files they created
      themselves. If the installer (running as admin) created the folder, the agent
      running under the staff account could not write its SQLite queue there at all:
      every INSERT would fail with SQLITE_READONLY and the agent would quietly store
      nothing.

      The ACL rules are written once, in AgentDataDirectory.Ensure(). Writing them again
      here in WiX would let the two definitions drift apart one day.
    -->
    <CustomAction Id="PrepareDataDir"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]oXeio.Agent.exe&quot; --prepare-data-dir"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- H02: start the watchdog at logon. Careful: the watchdog, not the agent. If the
         agent were started from two places, one machine would run two agents and count
         the same hours twice (see Deployment/WatchdogTask.xml). -->
    <CustomAction Id="InstallLogonTask"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]oXeio.Watchdog.exe&quot; --install-task"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="UninstallLogonTask"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]oXeio.Watchdog.exe&quot; --uninstall-task"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      Start the watchdog after install finishes.

      Careful: without this, nothing ran even after installing 0.3.1. The task was
      created fine, but its trigger is logon, so after the owner finished a double-click
      install no window appeared and no hours were counted until the next logon or
      reboot. The installer said success while nothing happened.

      Careful: the task cannot be started with `schtasks /Run`. Its principal is
      Group=Users (H02, so it runs for whoever logs in). A Group task has no single
      user, so Task Scheduler refuses to run it on demand ("The system cannot find the
      file specified", verified). Running the exe directly is the only way.

      Careful: Execute="immediate" is deliberate, not deferred. Deferred actions run as
      SYSTEM in session 0; started from there, nobody would see the sign-in window and
      the screen could not be captured. Immediate actions run in msiexec's client
      process, i.e. in the desktop session of whoever is installing.

      Careful: Return="asyncNoWait" must NOT be removed. The watchdog never exits on its
      own, so with check or ignore the installer would hang forever waiting for it.

      Careful: if an admin installs from their own account, the window opens in their
      session, not the staff member's. No harm: ProgramData's ACL has Users = Modify and
      ObjectInherit (AgentDataDirectory), so staff can later write files the admin
      created, and the task starts at the staff member's logon anyway.
    -->
    <CustomAction Id="StartWatchdog"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]oXeio.Watchdog.exe&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <!-- Careful: Return="ignore". When the process is not running, taskkill returns
         non-zero, which is normal here. With check, uninstall would fail just because
         "it was not running". -->
    <CustomAction Id="StopAgent"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[System64Folder]taskkill.exe&quot; /IM oXeio.Agent.exe /F"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="StopWatchdog"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[System64Folder]taskkill.exe&quot; /IM oXeio.Watchdog.exe /F"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- Needed on upgrades too: if the old exe keeps running, its files stay locked
           and MSI asks for a reboot. Asking a whole fleet to reboot means the rollout stalls.

           Careful: deferred actions MUST sit between InstallInitialize and
           InstallFinalize. These used to be placed before InstallValidate, which comes
           even before InstallInitialize, and the MSI build stopped (ICE77). -->
      <Custom Action="StopAgent" After="InstallInitialize" Condition="1" />
      <Custom Action="StopWatchdog" After="StopAgent" Condition="1" />

      <Custom Action="UninstallLogonTask" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot;" />

      <!-- After the files are in place, otherwise there would be no exe to call -->
      <Custom Action="PrepareDataDir" After="InstallFiles" Condition="NOT Installed OR REINSTALL" />
      <Custom Action="InstallLogonTask" After="PrepareDataDir" Condition="NOT Installed OR REINSTALL" />

      <!-- Careful: AFTER InstallFinalize. Before it the files are not final yet, and
           StopWatchdog's taskkill would kill the freshly started process.
           Does not run on uninstall: then Installed is true and REINSTALL is false. -->
      <Custom Action="StartWatchdog" After="InstallFinalize"
              Condition="NOT Installed OR REINSTALL" />
    </InstallExecuteSequence>

  </Package>
</Wix>
