<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = no console window. It starts quietly at logon and runs for weeks on
         end; with Exe a black console would flash up at every logon. -->
    <OutputType>WinExe</OutputType>

    <!-- Matches the agent: 10.0.17763 = Windows 10 1809. -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Brand icon: the red tile and white X from `web/public/favicon.svg`, so the web
           and the agent show the same face.

      Careful: it is embedded in the exe, so Explorer, the taskbar, alt-tab and
         "Add or remove programs" all show it. Nothing was set before, so Windows
         showed its default blank icon.

      Careful: the file is GENERATED by `installer/make-icon.py`, not drawn by hand.
         The TrayIconPainter doc explains why `.ico` binaries are not kept in the repo:
         diffs are unreadable. The exception holds here because the SOURCE is in the
         repo: to change the icon, change that script, and the diff shows it. The
         binary is only its output.
    -->
    <ApplicationIcon>..\..\installer\oxeio.ico</ApplicationIcon>

    <RootNamespace>oXeio.Watchdog</RootNamespace>
    <AssemblyName>oXeio.Watchdog</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Careful: it does not work without `LibraryImport` (source-generated P/Invoke):
         the generated code contains pointers. Without this the build stops with SYSLIB1062. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- UseWindowsForms is deliberately absent: the watchdog has no window, no message
         pump and no tray icon. Pulling in WinForms would bring a whole UI stack into
         this process that it has no use for, and that could crash. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Careful: Core only. Do NOT add a reference to oXeio.Agent: then a bug in the
         agent (such as SkiaSharp's native DLL failing to load) would take the watchdog
         down with it, and nobody would pick anybody up. -->
    <ProjectReference Include="..\oXeio.Core\oXeio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- LogicalName is given explicitly: the default name is built from the folder and
         file name, so moving the file would silently change it and the resource
         could no longer be found. -->
    <EmbeddedResource Include="Deployment\WatchdogTask.xml" LogicalName="oXeio.Watchdog.Task.xml" />
  </ItemGroup>

</Project>
