<?xml version="1.0" encoding="UTF-16"?>
<!--
  H02: automatic start at logon.

  Careful: this task starts the WATCHDOG, not the agent. The watchdog is the only one
  that starts the agent. If it were started from two places, one machine would run two
  agents and count the same hours twice: ruined payroll, and nobody would notice.

  {EXE} and {DIR} are replaced at install time (Deployment/TaskInstaller.cs).
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>oXeio</Author>
    <Description>oXeio এজেন্ট পাহারাদার — প্রতি ৩০ সেকেন্ডে দেখে, দরকার হলে আবার চালু করে।</Description>
    <URI>\oXeio\oXeio Watchdog</URI>
  </RegistrationInfo>

  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <!-- After the logon rush has eased a little: started immediately, the first few
           ticks would fail anyway because of disk and CPU contention. -->
      <Delay>PT15S</Delay>
    </LogonTrigger>
  </Triggers>

  <Principals>
    <Principal id="Author">
      <!-- S-1-5-32-545 = BUILTIN\Users. It runs in the session of whoever logs on.
           Careful: it cannot run as SYSTEM: it would go to Session 0, and an agent
           started from there would also land in Session 0 and be shut down at once. -->
      <GroupId>S-1-5-32-545</GroupId>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>

  <Settings>
    <!-- Careful: IgnoreNew, so that fast user switching or quick successive logons do
         not start a second watchdog. Two watchdogs would start killing each other's
         agent. -->
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>

    <!-- Careful: both defaults are true. Unplugging a laptop would silently switch the
         watch off. -->
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>

    <!-- Careful: the biggest trap. The default is PT72H: after three days Task
         Scheduler itself would kill the watchdog, and the machine would run
         unwatched. This process is meant to run for weeks, so there is no limit. -->
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>

    <!-- Careful: the default RunOnlyIfIdle=false, but StopOnIdleEnd=true would stop the
         task when the machine returns from idle. Self-defeating for a tool whose job is
         tracking idle. -->
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>

    <!-- A second safety net, in case the watchdog itself dies. -->
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>

    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <AllowHardTerminate>true</AllowHardTerminate>
    <Enabled>true</Enabled>
    <!-- Careful: Hidden=false is deliberate. Like the tray icon: it is not installed
         in hiding, and that must be provable. -->
    <Hidden>false</Hidden>
    <WakeToRun>false</WakeToRun>
    <DisallowStartOnRemoteAppSession>false</DisallowStartOnRemoteAppSession>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
    <Priority>6</Priority>
  </Settings>

  <Actions Context="Author">
    <Exec>
      <Command>{EXE}</Command>
      <WorkingDirectory>{DIR}</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
