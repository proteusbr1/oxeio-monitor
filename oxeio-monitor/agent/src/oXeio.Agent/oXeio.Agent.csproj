<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = no console window. The tray icon is the agent's only face.
         With Exe, every logon on the 15 PCs would leave a black console open, and
         the agent would die as soon as staff closed it.
         In diagnose mode Program.cs attaches a console itself. -->
    <OutputType>WinExe</OutputType>
    <!-- 10.0.17763 = Windows 10 1809, our minimum target.
         With a bare `net8.0-windows` the platform version defaults to 7.0, and then
         SupportedOSPlatformVersion cannot be set. -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- For NativeWindow: calling CreateWindowExW by hand risks bugs of the
         CallbackOnCollectedDelegate kind, because of the delegate's lifetime -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Careful: WPF itself is NOT used. It is here only for
         System.Windows.Automation (D03: the browser's address bar, ADR-013).
         UIAutomationClient ships as part of WPF.
         No size cost: a self-contained publish includes the WindowsDesktop runtime's
         WPF assemblies anyway; they just were not referenced. -->
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      Brand icon: the red tile and white X from `web/public/favicon.svg`, so the web
           and the agent show the same face.

      Careful: it is embedded in the exe, so Explorer, the taskbar, alt-tab and
         "Add or remove programs" all show it. Nothing was set before, so Windows
         showed its default blank icon.

      Careful: the file is GENERATED by `installer/make-icon.py`, not drawn by hand.
         The TrayIconPainter doc explains why `.ico` binaries are not kept in the repo:
         diffs are unreadable. The exception holds here because the SOURCE is in the
         repo: to change the icon, change that script, and the diff shows it. The
         binary is only its output.
    -->
    <ApplicationIcon>..\..\installer\oxeio.ico</ApplicationIcon>

    <RootNamespace>oXeio.Agent</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      WFAC010: the WinForms analyzer wants the DPI setting moved from the manifest to
      Application.SetHighDpiMode(). We deliberately do not follow it here.

      Reason: that API only works BEFORE the process creates its first HWND. A tray
      icon, NativeWindow, or any library's hidden window can create an HWND before
      Main's body runs; the call then fails silently, with no exception, and the process
      stays DPI-unaware. Screenshots from a 4K monitor at 150% scaling then come out
      blurry and small text is unreadable, yet reading that text is the whole point of
      the screenshots.

      The manifest applies before the process starts, so it is the only reliable way.
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!--
    `dotnet publish -p:HideLatestShot=true` (build.ps1 -HideLatestShot): a
    build whose Today window shows when the last screenshot was taken but
    not the picture, and keeps no copy of it on the PC. Capture and upload
    are unchanged. See BuildOptions.cs.
  -->
  <PropertyGroup Condition="'$(HideLatestShot)' == 'true'">
    <DefineConstants>$(DefineConstants);HIDE_LATEST_SHOT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Careful: `ApplicationIcon` is NOT enough. It fixes the exe's shell icon, but
         WinForms takes a Form's taskbar icon from `Form.Icon`, and without one it uses
         its own default icon. That is exactly why the blank white-and-blue window
         showed in the taskbar.

      So the same file is also embedded as a resource, and `OwnerDrawnForm` reads it.
         28 KB, negligible in a 62 MB MSI.
    -->
    <EmbeddedResource Include="..\..\installer\oxeio.ico" LogicalName="oXeio.Agent.brand.ico" />
  </ItemGroup>


  <ItemGroup>
    <!-- Careful: turning on UseWPF changes the SDK's implicit using set: System.IO
         and System.Net.Http are DROPPED, and then HttpClient or FileStream suddenly
         "cannot be found" and the build breaks. Nothing changed in the files, only one
         line was added to the csproj, so the cause takes a while to find. They are
         brought back explicitly. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\oXeio.Core\oXeio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- All the types here are `internal`: without letting the test project see them,
         no test could be written for the Win32-dependent modules. The types were not
         made `public` just for testing; that would widen the API surface. -->
    <InternalsVisibleTo Include="oXeio.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />

    <!-- Offline queue. Kept on the 8.x band: 9/10.x need .NET 9+, and the agent's
         TFM is net8.0-windows. EF Core is not pulled in, only the ADO.NET provider. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
  </ItemGroup>

</Project>
